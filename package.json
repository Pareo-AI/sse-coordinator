{
  "name": "sse-coordinator",
  "version": "0.3.2",
  "description": "Share a single SSE connection across browser tabs using BroadcastChannel leader election",
  "keywords": [
    "sse",
    "server-sent-events",
    "broadcast-channel",
    "multi-tab",
    "leader-election",
    "eventsource",
    "web-locks",
    "sharedworker",
    "realtime",
    "tab-coordination",
    "connection-limit",
    "multiplex",
    "eventsource-shared",
    "cross-tab"
  ],
  "license": "MIT",
  "author": "Jonathan Kaleve",
  "homepage": "https://github.com/Pareo-AI/sse-coordinator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pareo-AI/sse-coordinator.git"
  },
  "bugs": "https://github.com/Pareo-AI/sse-coordinator/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "//": "HOLD typescript on ^6.0.3: tsup (rollup-plugin-dts) needs the TypeScript compiler API, which TypeScript 7.0.2 does not ship, so the DTS build fails, https://github.com/egoist/tsup/issues/1408. RE-CHECK when tsup supports TypeScript 7: bun add -d typescript@latest && bun run build, then DELETE this hold. Since 2026-10-31.",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "picomatch": ">=4.0.4"
  }
}
